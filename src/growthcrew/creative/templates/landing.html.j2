<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ hero.headline }}</title>
<!-- Variant: {{ angle }}. Generated by GrowthCrew from an approved landing hero; edit freely. -->
<style>
  :root {
    --bg: {{ kit.background }}; --text: {{ kit.text }}; --primary: {{ kit.primary }};
    --cta-text: {{ kit.cta_text }}; --accent: {{ kit.accent }};
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--text); font: 400 18px/1.55 {{ kit.body_font | safe }}; }
  .hero { max-width: 1120px; margin: 0 auto; padding: 72px 24px; display: grid; gap: 48px; align-items: center; }
  @media (min-width: 900px) { .hero { grid-template-columns: {% if kit.product_image %}1.1fr 0.9fr{% else %}1fr{% endif %}; padding: 112px 32px; } }
  .logo { height: 40px; width: auto; margin-bottom: 32px; }
  h1 { margin: 0; font: 700 clamp(2.2rem, 5vw, 3.6rem)/1.06 {{ kit.heading_font | safe }}; letter-spacing: -0.02em; }
  .sub { margin: 20px 0 0; font-size: 1.2rem; max-width: 36em; }
  .cta { display: inline-block; margin-top: 32px; padding: 16px 28px; border-radius: 999px; background: var(--primary);
         color: var(--cta-text); font-weight: 600; text-decoration: none; min-height: 48px; }
  .cta:focus-visible { outline: 3px solid var(--accent); outline-offset: 3px; }
  ul { margin: 28px 0 0; padding: 0; list-style: none; display: grid; gap: 10px; }
  li { padding-left: 28px; position: relative; }
  li::before { content: ""; position: absolute; left: 0; top: 0.6em; width: 12px; height: 12px; border-radius: 3px; background: var(--accent); }
  .proof { margin-top: 28px; font-size: 0.95rem; opacity: 0.85; }
  .image { width: 100%; height: auto; border-radius: 20px; }
</style>
</head>
<body>
  <section class="hero" data-variant="{{ angle }}">
    <div>
      {% if kit.logo %}<img class="logo" src="{{ kit.logo }}" alt="{{ brand_name }} logo">{% endif %}
      <h1>{{ hero.headline }}</h1>
      <p class="sub">{{ hero.subheadline }}</p>
      <a class="cta" href="#start" data-variant="{{ angle }}">{{ hero.primary_cta }}</a>
      {% if hero.supporting_points %}
      <ul>{% for point in hero.supporting_points %}<li>{{ point }}</li>{% endfor %}</ul>
      {% endif %}
      {% if hero.social_proof_line %}<p class="proof">{{ hero.social_proof_line }}</p>{% endif %}
    </div>
    {% if kit.product_image %}<img class="image" src="{{ kit.product_image }}" alt="{{ alt_text }}">{% endif %}
  </section>
</body>
</html>
